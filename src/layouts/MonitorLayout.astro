---
// 데브로그 틀 — 방 책상 위 모니터 화면 모양. 방에서 컴퓨터를 누르면 이 화면으로 넘어온다.
// 글마다 주소가 따로 있어서, 링크로 바로 들어온 손님도 이 모니터 화면부터 본다.
// 맨 아래 「책상으로 돌아가기」는 방 첫 벽(/#room-n)으로 간다.
import HeadMeta from '../components/HeadMeta.astro';
import { ui, type Lang } from '../lib/i18n';
import { paletteStyle } from '../lib/palette';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  altPath?: string | null;
}

const { lang, title, description, altPath } = Astro.props;
const t = ui[lang];
const shownAddress = (Astro.site ? Astro.site.host : '') + Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <HeadMeta lang={lang} title={title} description={description} altPath={altPath} />
    <Fragment set:html={paletteStyle()} />
  </head>
  <body class="desk">
    <div class="monitor">
      <div class="bezel">
        <div class="screen">
          <div class="addr"><i aria-hidden="true"></i><span>{shownAddress}</span></div>
          <main class="scr">
            <slot />
          </main>
        </div>
      </div>
      <a class="go" href="/#room-n">{t.backToDesk}</a>
    </div>
  </body>
</html>

<style is:global>
  /* 색은 src/lib/palette.ts 한 곳에서 온다. 모니터 테두리만 어떤 색 벌에서나 검은 플라스틱이다 */
  :root {
    --hand: "Gowun Dodum", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;   /* 글꼴은 고운 돋움 하나 — 코드 조각만 고정폭 */
    --bezel: #1E1C1B;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { height: 100%; }
  body.desk {
    margin: 0; background: var(--bg); color: var(--ink); font-family: var(--hand);
    padding: max(14px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px))
      max(14px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
  }
  /* 방에서 모니터로 다가간 다음 장면 — 살짝 큰 데서 제자리로 */
  .monitor { height: 100%; display: flex; flex-direction: column; align-items: center; gap: 14px; animation: mon-in .45s cubic-bezier(.2, .8, .2, 1); }
  @keyframes mon-in { from { opacity: 0; transform: scale(1.04); } }
  .bezel {
    position: relative; width: min(940px, 100%); flex: 1 1 auto; min-height: 0; display: flex; padding: 16px 16px 34px;
    background: var(--bezel); border-radius: 20px; box-shadow: 0 30px 70px -30px rgba(0, 0, 0, .55);
  }
  .bezel::after {
    content: ""; position: absolute; left: 50%; bottom: 12px; width: 9px; height: 9px; margin-left: -4.5px;
    border-radius: 50%; background: var(--s2); box-shadow: 0 0 8px var(--s2);
  }
  .screen { flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column; border-radius: 8px; overflow: hidden; background: var(--sheet); }
  .addr {
    display: flex; align-items: center; gap: 10px; padding: 9px 14px; font-size: 13px; color: var(--ink-soft);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 10%, transparent); background: color-mix(in srgb, var(--ink) 3%, var(--sheet));
  }
  .addr i { display: flex; gap: 6px; flex: none; }
  .addr i::before, .addr i::after { content: ""; width: 9px; height: 9px; border-radius: 50%; background: color-mix(in srgb, var(--ink) 18%, transparent); }
  .addr span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 3px 12px; border-radius: 999px; background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .scr { flex: 1; min-height: 0; overflow: auto; padding: 30px clamp(18px, 4vw, 48px) 44px; font-size: 16.5px; line-height: 1.8; }
  /* 한국어는 띄어쓰기 자리에서만 줄을 넘긴다 — 없으면 낱말 가운데서 끊긴다 (2026-10-17) */
  .scr { word-break: keep-all; overflow-wrap: break-word; }
  .scr h1 { font-weight: 700; font-size: 34px; line-height: 1.25; letter-spacing: -.01em; margin: 6px 0 0; text-wrap: balance; }
  .scr .meta { color: var(--ink-soft); font-size: 14px; margin: 6px 0 0; font-variant-numeric: tabular-nums; }
  .scr .soon { color: var(--ink-soft); margin-top: 22px; }

  /* 단추 — 책상으로 돌아가기(진한 알약) · 목록으로(테두리만) */
  .go {
    display: inline-flex; align-items: center; gap: 8px; font: 15px/1.3 var(--hand); color: var(--hi); background: var(--ink);
    text-decoration: none; border-radius: 999px; padding: 10px 18px; transition: transform .15s, background .15s;
  }
  .go:hover { transform: translateY(-1px); background: color-mix(in srgb, var(--ink) 85%, var(--s3)); }
  .monitor > .go::before { content: "←"; }
  .go.small { font-size: 14px; padding: 7px 14px; color: var(--ink); background: transparent; box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--ink) 25%, transparent); }
  .go.small:hover { background: transparent; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .go:focus-visible, .row:focus-visible { outline: 2.5px solid var(--s2); outline-offset: 3px; }

  /* 글 목록 */
  .rows { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 4px; }
  .row {
    display: grid; grid-template-columns: 168px 1fr; gap: 20px; align-items: center; padding: 14px; margin: 0 -14px;
    border-radius: 12px; color: inherit; text-decoration: none; transition: background .15s;
  }
  .row:hover { background: color-mix(in srgb, var(--s1) 32%, transparent); }
  .row .thumb { width: 168px; max-width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 8px; background: var(--a2); }
  .row .txt { display: grid; gap: 2px; min-width: 0; }
  .row time { color: var(--ink-soft); font-size: 13.5px; font-variant-numeric: tabular-nums; }
  .row b { font-weight: 700; font-size: 21px; line-height: 1.35; }
  .row .sum { color: var(--ink-soft); font-size: 15px; }

  /* 글 본문 */
  article h1 { margin-top: 18px; }
  .post-body { margin-top: 22px; }
  .post-body h2 { font-weight: 700; font-size: 23px; line-height: 1.4; margin: 36px 0 10px; }
  .post-body h3 { font-weight: 700; font-size: 19px; margin: 28px 0 8px; }
  .post-body p { margin: 0 0 18px; max-width: 66ch; }
  .post-body img { max-width: 100%; height: auto; display: block; margin: 24px 0; border-radius: 8px; }
  .post-body ul, .post-body ol { margin: 0 0 18px; padding-left: 22px; max-width: 66ch; }
  .post-body li { margin-bottom: 6px; }
  .post-body blockquote { margin: 0 0 18px; padding: 4px 16px; border-left: 3px solid var(--s2); color: var(--ink-soft); }
  .post-body code { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-size: .9em; background: color-mix(in srgb, var(--ink) 6%, transparent); padding: 1px 5px; border-radius: 4px; }
  .post-body pre { overflow-x: auto; background: color-mix(in srgb, var(--ink) 6%, transparent); padding: 12px 14px; border-radius: 8px; }
  .post-body pre code { background: none; padding: 0; }
  .post-body a { color: var(--link); text-underline-offset: 3px; }

  @media (max-width: 600px) {
    .bezel { padding: 10px 10px 28px; border-radius: 16px; }
    .scr { padding: 18px 16px 28px; }
    .scr h1 { font-size: 28px; }
    .row { grid-template-columns: 96px 1fr; gap: 14px; }
    .row .thumb { width: 96px; }
  }
  @media (prefers-reduced-motion: reduce) { .monitor { animation: none; } .go, .row { transition: none; } }
</style>
