---
// 데브로그 틀 — 방 책상 위 모니터 화면 모양. 방에서 컴퓨터를 누르면 이 화면으로 넘어온다.
// 글마다 주소가 따로 있어서, 링크로 바로 들어온 손님도 이 모니터 화면부터 본다.
// 맨 아래 「책상으로 돌아가기」는 방 첫 벽(/#room-n)으로 간다.
import HeadMeta from '../components/HeadMeta.astro';
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  altPath?: string | null;
}

const { lang, title, description, altPath } = Astro.props;
const t = ui[lang];
const shownAddress = (Astro.site ? Astro.site.host : '') + Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <HeadMeta lang={lang} title={title} description={description} altPath={altPath} />
  </head>
  <body class="desk">
    <div class="monitor">
      <div class="bezel">
        <div class="screen">
          <div class="addr"><i aria-hidden="true"></i><span>{shownAddress}</span></div>
          <main class="scr">
            <slot />
          </main>
        </div>
      </div>
      <a class="go" href="/#room-n">{t.backToDesk}</a>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ebe8e1; --paper-hi: #f4f2ed; --grid: #d3cdc1; --ink: #3a2a20; --ink-soft: #7d6858; --desk: #2d2926;
    --hand: "Gowun Dodum", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
    --body: "Gowun Dodum", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
    --title: "Gowun Dodum", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { height: 100%; }
  body.desk {
    margin: 0; background: var(--desk); color: var(--ink); font-family: var(--body);
    padding: max(14px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px))
      max(14px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
  }
  .monitor { height: 100%; display: flex; flex-direction: column; align-items: center; gap: 12px; animation: mon-in .45s ease-out; }
  @keyframes mon-in { from { opacity: 0; transform: scale(.97); } to { opacity: 1; transform: none; } }
  .bezel {
    position: relative; width: min(900px, 100%); flex: 1 1 auto; min-height: 0; display: flex; padding: 20px 22px 36px;
    background: var(--paper); border: 3px solid var(--ink); border-radius: 22px 17px 24px 15px;
  }
  .bezel::after {
    content: ""; position: absolute; left: 50%; bottom: 10px; width: 12px; height: 12px; margin-left: -8px;
    border: 2.5px solid var(--ink); border-radius: 50%;
  }
  .screen {
    flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column;
    border: 3px solid var(--ink); border-radius: 5px 7px 4px 6px; background: var(--paper-hi); overflow: hidden;
  }
  .addr {
    display: flex; align-items: center; gap: 10px; padding: 6px 12px; border-bottom: 2.5px solid var(--ink); background: var(--paper);
    font-family: var(--body); font-size: 13px; color: var(--ink-soft);
  }
  .addr i { width: 9px; height: 9px; border-radius: 50%; border: 2px solid var(--ink); flex: none; }
  .addr span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .scr { flex: 1; min-height: 0; overflow: auto; padding: 18px 26px 30px; font-size: 16px; line-height: 1.8; }
  /* 한국어는 띄어쓰기 자리에서만 줄을 넘긴다 — 없으면 낱말 가운데서 끊긴다 (2026-10-17) */
  .scr { word-break: keep-all; overflow-wrap: break-word; }
  .scr h1 { font-family: var(--title); font-weight: 700; font-size: 30px; line-height: 1.3; margin: 10px 0 4px; text-wrap: balance; }
  .scr .meta { color: var(--ink-soft); font-size: 13.5px; margin: 0 0 10px; font-variant-numeric: tabular-nums; }
  .scr .soon { color: var(--ink-soft); font-family: var(--title); }

  .go {
    display: inline-block; font-family: var(--body); font-weight: 500; font-size: 14.5px; line-height: 1.4; color: var(--ink);
    text-decoration: none; background: var(--paper-hi); border: 2.5px solid var(--ink); border-radius: 10px 13px 9px 12px; padding: 6px 13px;
  }
  .go:hover { background: var(--ink); color: var(--paper-hi); }
  .go:focus-visible, .row:focus-visible { outline: 3px solid var(--paper-hi); outline-offset: 3px; }
  .scr .go:focus-visible, .scr .row:focus-visible { outline-color: var(--ink); }
  .go.small { font-size: 13.5px; padding: 4px 10px; }

  /* 글 목록 */
  .rows { list-style: none; margin: 8px 0 0; padding: 0; }
  .row {
    display: grid; grid-template-columns: 120px 1fr; gap: 16px; align-items: start; padding: 14px 6px;
    border-top: 2px dashed var(--grid); color: inherit; text-decoration: none;
  }
  .row:hover { background: var(--paper); }
  .row .thumb { width: 120px; height: auto; border: 2px solid var(--ink); border-radius: 3px; }
  .row .txt { display: grid; gap: 2px; min-width: 0; }
  .row time { color: var(--ink-soft); font-size: 13px; font-variant-numeric: tabular-nums; }
  .row b { font-family: var(--title); font-weight: 700; font-size: 20px; line-height: 1.35; }
  .row .sum { color: var(--ink-soft); font-size: 14.5px; }

  /* 글 본문 */
  .post-body { margin-top: 18px; }
  .post-body h2 { font-family: var(--title); font-weight: 700; font-size: 22px; line-height: 1.4; margin: 32px 0 10px; }
  .post-body h3 { font-family: var(--title); font-weight: 700; font-size: 18px; margin: 26px 0 8px; }
  .post-body p { margin: 0 0 16px; max-width: 66ch; }
  .post-body img { max-width: 100%; height: auto; display: block; margin: 22px 0; border: 2px solid var(--ink); border-radius: 4px; }
  .post-body ul, .post-body ol { margin: 0 0 16px; padding-left: 22px; }
  .post-body li { margin-bottom: 6px; }
  .post-body blockquote { margin: 0 0 16px; padding: 4px 16px; border-left: 4px solid var(--ink); color: var(--ink-soft); }
  .post-body code { font-family: ui-monospace, "Consolas", monospace; font-size: .92em; background: var(--paper); padding: 1px 5px; border-radius: 3px; }
  .post-body pre { overflow-x: auto; background: var(--paper); padding: 12px 14px; border-radius: 4px; }
  .post-body pre code { background: none; padding: 0; }
  .post-body a { color: var(--ink); }

  @media (max-width: 600px) {
    .bezel { padding: 12px 12px 30px; border-radius: 16px 13px 18px 12px; }
    .scr { padding: 12px 14px 22px; }
    .row { grid-template-columns: 84px 1fr; gap: 12px; }
    .row .thumb { width: 84px; }
  }
  @media (prefers-reduced-motion: reduce) { .monitor { animation: none; } }
</style>
