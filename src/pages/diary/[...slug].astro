---
// 일기 한 편 — 줄 공책 모양. 방 넷째 벽 수납장 서랍을 누르면 일기 목록이 뜨고, 그중 하나를 누르면 여기로 온다.
// 「방으로 돌아가기」는 넷째 벽(/#room-w)으로 간다. 일기는 한글판만 있다.
import { render } from 'astro:content';
import HeadMeta from '../../components/HeadMeta.astro';
import { loadDiary, diarySlug } from '../../lib/diary';
import { formatDate } from '../../lib/date';
import { ui } from '../../lib/i18n';

export async function getStaticPaths() {
  const entries = await loadDiary();
  return entries.map((entry) => ({
    params: { slug: diarySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry as any);
const t = ui.ko;
---

<!doctype html>
<html lang="ko">
  <head>
    <HeadMeta lang="ko" title={entry.data.title} description={t.diaryDescription} altPath={null} />
  </head>
  <body class="table-top">
    <main class="notebook">
      <a class="go" href="/#room-w">&larr; {t.backToRoom}</a>
      <h1>{entry.data.title}</h1>
      <p class="meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, 'ko')}</time></p>
      <div class="diary-body">
        <Content />
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ebe8e1; --paper-hi: #f4f2ed; --grid: #d3cdc1; --ink: #3a2a20; --ink-soft: #7d6858; --desk: #2d2926;
    --body: "Gowun Dodum", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
    --title: "Gowun Dodum", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
    color-scheme: light;
  }
  *, *::before, *::after { box-sizing: border-box; }
  body.table-top {
    margin: 0; min-height: 100vh; background: var(--desk); color: var(--ink); font-family: var(--body);
    padding: max(24px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px))
      max(32px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
  }
  .notebook {
    width: min(720px, 100%); margin: 0 auto; padding: 26px 28px 36px 40px;
    background-color: var(--paper-hi);
    border: 2.5px solid var(--ink); border-left-width: 12px; border-radius: 6px 12px 10px 6px;
    box-shadow: 7px 9px 0 rgba(0, 0, 0, .28);
    animation: book-in .4s ease-out;
  }
  @keyframes book-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  /* 한국어는 띄어쓰기 자리에서만 줄을 넘긴다 — 없으면 「두 줄 / 로」처럼 낱말 가운데서 끊긴다 */
  .notebook { word-break: keep-all; overflow-wrap: break-word; }
  .notebook h1 { font-family: var(--title); font-weight: 700; font-size: 28px; line-height: 1.3; margin: 18px 0 2px; text-wrap: balance; }
  .notebook .meta { color: var(--ink-soft); font-size: 13.5px; margin: 0 0 10px; font-variant-numeric: tabular-nums; }
  .diary-body {
    font-size: 16px; line-height: 32px;
    /* 공책 줄은 본문에만 긋는다. 공책 맨 위부터 그으면 제목 · 날짜 높이만큼 어긋나 줄이 글자를 가로지른다 (2026-10-17) */
    background-image: linear-gradient(transparent 31px, var(--grid) 31px);
    background-size: 100% 32px;
  }
  /* 옵시디언에서 엔터로 나눈 줄을 사이트에서도 나눈다 — 없으면 두 줄이 한 줄로 붙는다 (2026-10-17) */
  .diary-body p { margin: 0 0 32px; white-space: pre-line; }
  .diary-body h2, .diary-body h3 { font-family: var(--title); font-size: 19px; line-height: 32px; margin: 0 0 0; }
  .diary-body ul, .diary-body ol { margin: 0 0 32px; padding-left: 22px; }
  .diary-body img { max-width: 100%; height: auto; display: block; margin: 0 0 32px; border: 2px solid var(--ink); }
  .diary-body a { color: var(--ink); }
  .go {
    display: inline-block; font-family: var(--body); font-weight: 500; font-size: 14px; line-height: 1.4; color: var(--ink);
    text-decoration: none; background: var(--paper-hi); border: 2.5px solid var(--ink); border-radius: 10px 13px 9px 12px; padding: 5px 12px;
  }
  .go:hover { background: var(--ink); color: var(--paper-hi); }
  .go:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  @media (max-width: 600px) { .notebook { padding: 18px 16px 28px 24px; border-left-width: 9px; } }
  @media (prefers-reduced-motion: reduce) { .notebook { animation: none; } }
</style>
