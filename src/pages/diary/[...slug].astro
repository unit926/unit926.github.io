---
// 일기 한 편 — 줄 공책 모양. 방 넷째 벽 수납장 서랍을 누르면 일기 목록이 뜨고, 그중 하나를 누르면 여기로 온다.
// 「방으로 돌아가기」는 넷째 벽(/#room-w)으로 간다. 일기는 한글판만 있다.
import { render } from 'astro:content';
import HeadMeta from '../../components/HeadMeta.astro';
import { loadDiary, diarySlug } from '../../lib/diary';
import { formatDate } from '../../lib/date';
import { ui } from '../../lib/i18n';
import { paletteStyle } from '../../lib/palette';

export async function getStaticPaths() {
  const entries = await loadDiary();
  return entries.map((entry) => ({
    params: { slug: diarySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry as any);
const t = ui.ko;
---

<!doctype html>
<html lang="ko">
  <head>
    <HeadMeta lang="ko" title={entry.data.title} description={t.diaryDescription} altPath={null} />
    <Fragment set:html={paletteStyle()} />
  </head>
  <body class="table-top">
    <main class="notebook">
      <a class="go" href="/#room-w">&larr; {t.backToRoom}</a>
      <h1>{entry.data.title}</h1>
      <p class="meta"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, 'ko')}</time></p>
      <div class="diary-body">
        <Content />
      </div>
    </main>
  </body>
</html>

<style is:global>
  /* 색은 src/lib/palette.ts 한 곳에서 온다. 공책은 방의 서랍에서 꺼낸 일기장 종이와 같은 모양이다 */
  :root { --hand: "Gowun Dodum", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif; }
  *, *::before, *::after { box-sizing: border-box; }
  body.table-top {
    margin: 0; min-height: 100vh; background: var(--bg); color: var(--ink); font-family: var(--hand);
    padding: max(24px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px))
      max(32px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
  }
  .notebook {
    width: min(720px, 100%); margin: 0 auto; padding: 26px 28px 40px 66px; border-radius: 5px;
    background-color: var(--sheet);
    background-image: linear-gradient(90deg, transparent 46px, color-mix(in srgb, var(--bad) 45%, transparent) 46px 47.5px, transparent 47.5px);
    box-shadow: inset 8px 0 0 var(--s3), 0 1px 1px rgba(0, 0, 0, .05), 0 26px 60px -14px rgba(30, 20, 10, .32), 0 10px 22px -12px rgba(30, 20, 10, .22);
    animation: book-in .4s ease-out;
  }
  @keyframes book-in { from { opacity: 0; transform: translateY(14px); } }
  /* 한국어는 띄어쓰기 자리에서만 줄을 넘긴다 — 없으면 「두 줄 / 로」처럼 낱말 가운데서 끊긴다 */
  .notebook { word-break: keep-all; overflow-wrap: break-word; }
  .notebook h1 { font-weight: 700; font-size: 28px; line-height: 1.3; margin: 20px 0 2px; text-wrap: balance; }
  .notebook .meta { color: var(--ink-soft); font-size: 13.5px; margin: 0 0 12px; font-variant-numeric: tabular-nums; }
  .diary-body {
    font-size: 16.5px; line-height: 34px;
    /* 공책 줄은 본문에만 긋는다. 공책 맨 위부터 그으면 제목 · 날짜 높이만큼 어긋나 줄이 글자를 가로지른다 (2026-10-17) */
    background-image: linear-gradient(transparent 33px, color-mix(in srgb, var(--ink) 12%, transparent) 33px);
    background-size: 100% 34px;
  }
  /* 옵시디언에서 엔터로 나눈 줄을 사이트에서도 나눈다 — 없으면 두 줄이 한 줄로 붙는다 (2026-10-17) */
  .diary-body p { margin: 0 0 34px; white-space: pre-line; }
  .diary-body h2, .diary-body h3 { font-size: 19px; line-height: 34px; margin: 0; }
  .diary-body ul, .diary-body ol { margin: 0 0 34px; padding-left: 22px; }
  .diary-body img { max-width: 100%; height: auto; display: block; margin: 0 0 34px; border-radius: 6px; }
  .diary-body a { color: var(--s3); }
  .go {
    display: inline-flex; align-items: center; gap: 8px; font: 14px/1.3 var(--hand); color: var(--ink); text-decoration: none;
    border-radius: 999px; padding: 7px 14px; box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--ink) 25%, transparent); transition: box-shadow .15s;
  }
  .go:hover { box-shadow: inset 0 0 0 1.5px var(--ink); }
  .go:focus-visible { outline: 2.5px solid var(--s2); outline-offset: 3px; }
  @media (max-width: 600px) { .notebook { padding: 18px 16px 30px 48px; background-image: linear-gradient(90deg, transparent 32px, color-mix(in srgb, var(--bad) 45%, transparent) 32px 33.5px, transparent 33.5px); } }
  @media (prefers-reduced-motion: reduce) { .notebook { animation: none; } }
</style>
