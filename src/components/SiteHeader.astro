---
import { ui, tabsFor, otherLangPath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const base = lang === 'ko' ? '' : '/en';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const homePath = base || '/';

const tabs = tabsFor(lang).map((tab) => {
  const clean = tab.href.replace(/\/+$/, '') || '/';
  const on =
    tab.key === 'devlog'
      ? path === homePath || path.startsWith(`${base}/devlog`)
      : path === clean || path.startsWith(`${clean}/`);
  return { ...tab, on };
});

const otherHref = otherLangPath(lang, Astro.url.pathname);
---

<header class="site-header">
  <a class="site-name" href={`${base}/`}>{t.siteName}</a>
  <div class="site-right">
    <nav class="site-tabs" aria-label={t.menuLabel}>
      {
        tabs.map((tab) => (
          <a
            href={tab.href}
            class={tab.on ? 'tab on' : 'tab'}
            aria-current={tab.on ? 'page' : undefined}
          >{tab.label}</a>
        ))
      }
    </nav>
    <a
      class="lang-switch"
      href={otherHref}
      hreflang={lang === 'ko' ? 'en' : 'ko'}
      aria-label={t.langLabel}
    >{lang === 'ko' ? 'EN' : 'KO'}</a>
  </div>
</header>
