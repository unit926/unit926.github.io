---
import { Image } from 'astro:assets';
import { formatDate } from '../lib/date';
import { postPath } from '../lib/posts';
import type { Lang } from '../lib/i18n';

interface Props {
  post: any;
  lang: Lang;
}

const { post, lang } = Astro.props;
---

<article class="row">
  <a class="row-link" href={postPath(lang, post)}>
    <Image
      class="row-thumb"
      src={post.data.thumbnail}
      alt={post.data.thumbnailAlt}
      width={400}
      loading="lazy"
    />
    <div class="row-text">
      <h2 class="row-title">{post.data.title}</h2>
      {post.data.summary && <p class="row-summary">{post.data.summary}</p>}
      <p class="row-date">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
      </p>
    </div>
  </a>
</article>
