    const sb = deco(`<rect class="ink pf" x="${sbx}" y="-193" width="${sbw}" height="193"/><path class="ink" d="M${sbx} -12 H${sbx + sbw}"/>
      <path class="ink thin" d="M${sbx + 180} -193 V-12 M${sbx} -112 H${sbx + 180} M${sbx + 180 + (sbw - 180) / 2} -193 V-12"/>
      <path class="ink pf" d="M${sbx + sbw - 90} -193 L${sbx + sbw - 46} -193 L${sbx + sbw - 52} -236 L${sbx + sbw - 84} -236 Z"/>
      <path class="ink thin" d="M${sbx + sbw - 68} -236 Q${sbx + sbw - 96} -300 ${sbx + sbw - 80} -330 M${sbx + sbw - 68} -236 Q${sbx + sbw - 60} -310 ${sbx + sbw - 40} -340 M${sbx + sbw - 68} -236 V-318"/>`);
    const drawer = O('drawer', '서랍 — 일기장', [sbx + 6, -190, 168, 76], `<g class="drawer-front"><rect class="ink pf" x="${sbx + 12}" y="-180" width="156" height="58"/><path class="ink" d="M${sbx + 70} -151 H${sbx + 110}"/></g>`, [sbx + 172, -188]);
