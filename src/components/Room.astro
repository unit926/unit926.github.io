    const door = O('door', '926호 문', [0, -630, 285, 630], doorway + `<g class="door-closed">${doorPic(0)}</g><g class="door-open">${doorPic(1)}</g>`, true);
    // 매트와 예비 열쇠
    const key = O('key', '예비 열쇠', [80, 6, 160, 50], layer(() => {
      const c = pj(128, 0, 96); EL(c[0], c[1], 13, 9, K2, 's2'); EL(c[0], c[1], 5, 3.5, 1.2, 'floor');
