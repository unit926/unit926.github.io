      L(x0, -330, x1, -330, K2); L(x0, -321, x1, -321, K3, { soft: true });
      L(x0, -18, x1, -18, K3); L(x0, 0, x1, 0, K2);
      for (let i = -7; i <= 8; i++) { const x = 142.5 + i * 180 - 90, k = (bot - VY) / (0 - VY); L(x, 0, VX + (x - VX) * k, bot, 1.5, { soft: true, ov: 0 }); }
      for (const z of [110, 270, 440, 640]) { const y = pj(0, 0, z)[1]; if (y < bot) L(x0, y, x1, y, 1.5, { soft: true, ov: 0 }); }
