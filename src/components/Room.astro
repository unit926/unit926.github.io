      const p = pts[i], q = pts[Math.max(0, i - 1)], r = pts[Math.min(n - 1, i + 1)];
      let dx = r[0] - q[0], dy = r[1] - q[1]; const d = Math.hypot(dx, dy) || 1; dx /= d; dy /= d;
      const u = Math.min(1, cum[i] / ra), v = Math.min(1, (tot - cum[i]) / rb);
      const hw = w * .5 * (a + (1 - a) * Math.sqrt(u)) * (b + (1 - b) * Math.sqrt(v)) * (1 + .14 * Math.sin(ph + cum[i] * fr * 6.3));
