  }

  /* 우편함 — 손그림 몸통 · 덮개 두 장(닫힘 · 열림). 덮개 자리는 람호 참고 그림 두 장에 겹쳐 맞춘 값(원본 픽셀 ÷ 2).
     예전 우편함보다 세로로 길어 가운데는 예전 자리에 두고, 아랫변이 아래 띠 선(-328)에 닿지 않게 올렸다 */
  /* 주문서 종이 — 덮개가 열린 아래 칸에서 올라온다(위 투입구는 편지를 넣는 곳이다 · 람호 2026-10-25).
     람호가 손그림을 그리는 중이라 그림이 오기 전에는 종이를 안 내보낸다 — 오면 ['이름', 원본 가로, 원본 세로] 를 넣는다 */
  const MAIL_PAPER = null;
  function gMailbox() {
    const x = W(-375, -253), y = -541, hy = y + 175, cid = 'mc' + (++UID);   // hy = 아래 칸 아랫변(덮개 경첩)
    let paper = '';
