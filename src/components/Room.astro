---
// 현관과 방 — 첫 화면. 그림과 움직임이 이 파일 하나에 있다(시험판 손그림판 5판에서 옮겨 왔다 · 2026-10-17).
// 이을 곳 주소는 아래 LINKS 한 곳만 채우면 된다. 빈 값이면 그 창에 「준비 중입니다.」가 뜬다.
// 서랍 속 일기장 목록은 src/content/diary/ 의 글에서 저절로 만들어진다.
import { loadDiary, diaryPath } from "../lib/diary";
import { formatDate } from "../lib/date";

const LINKS = {
  steam: "",        // 흑색잔상 Steam 페이지
  itch: "https://unit926.itch.io",
  x: "https://x.com/unit_926",
  reddit: "https://www.reddit.com/user/unit926",
  youtube: "https://www.youtube.com/@Unit926",
  discord: "",      // 디스코드 초대 링크
  artstation: "",   // 아트스테이션
  playlist: "",     // 람호 유튜브 재생목록 — 개발하면서 듣는 노래
  email: "",        // 연락받을 메일 주소
};

const diary = (await loadDiary()).map((d) => ({ title: d.data.title, date: formatDate(d.data.date, "ko"), href: diaryPath(d) }));
const data = JSON.stringify({ links: LINKS, diary }).replace(/</g, "\\u003c");
---

<h1 class="sr">람호 / unit926 — 개발자 홈페이지</h1>
<main id="stage" class="stage gridpaper" aria-label="개발자 홈페이지">
  <svg id="art" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" role="group" aria-label="현관과 작업실"></svg>
  <div class="bar">
    <button type="button" class="pill strong" id="pressBtn">PRESS KIT</button>
    <button type="button" class="pill" id="muteBtn" aria-pressed="false">소리 켬</button>
  </div>
  <button type="button" class="nav l" id="navL" aria-label="왼쪽 벽으로 돌기" hidden><svg viewBox="0 0 54 92"><path d="M38 14 L14 46 L38 78"/></svg></button>
  <button type="button" class="nav r" id="navR" aria-label="오른쪽 벽으로 돌기" hidden><svg viewBox="0 0 54 92"><path d="M16 14 L40 46 L16 78"/></svg></button>
  <div class="dots" id="dots" hidden aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="tip" id="tip" aria-hidden="true"></div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</main>

<script type="application/json" id="room-data" set:html={data}></script>

<style is:global>
:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
img{max-width:100%}
.noscript{position:fixed;inset:0;z-index:20;padding:32px max(16px,env(safe-area-inset-left,0px));background:#ebe8e1;color:#3a2a20;font-family:"IBM Plex Sans KR","Malgun Gothic",sans-serif}
/* 배치: 모눈종이 한 장이 무대다. 컴퓨터에서는 어두운 책상 위 종이 한 장(가로 16:10), 휴대폰 · 세로 화면에서는 화면 전체가 종이(세로 배치) */
:root{
  --paper:#ebe8e1; --paper-hi:#f4f2ed; --grid:#d3cdc1; --ink:#3a2a20; --ink-soft:#7d6858;
  --desk:#2d2926; --red:#c4412f; --green:#3e8a49;
  --hand:"Gaegu","Nanum Pen Script","Comic Sans MS",cursive;
  --body:"IBM Plex Sans KR","Apple SD Gothic Neo","Malgun Gothic","Noto Sans KR",sans-serif;
  --title:"Gowun Batang","Nanum Myeongjo","Batang",serif;   /* 창 제목 · 글 제목 — 손글씨는 그림 속 큰 글자에만 */
  color-scheme:light;
}
[hidden]{display:none!important}
html,body{height:100%}
body{margin:0;box-sizing:border-box;background:var(--desk);color:var(--ink);font-family:var(--body);
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:16px;
  display:flex;align-items:center;justify-content:center;overflow:hidden}
.gridpaper{background-color:var(--paper);
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:22px 22px}
body.full{padding-block:0;background-color:var(--paper);
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:22px 22px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.stage{position:relative;max-width:100%}
body.framed .stage{width:min(1200px,100%,calc((100vh - 32px) * 1.6));aspect-ratio:16/10;border-radius:3px;box-shadow:0 22px 60px rgba(0,0,0,.5)}
body.full .stage{width:100%;height:100%;background:none}
.stage>svg{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:manipulation}

/* 그림 선 */
.ink{fill:none;stroke:var(--ink);stroke-width:4;stroke-linecap:round;stroke-linejoin:round}
.thin{stroke-width:3}
.pf{fill:var(--paper)}
.inkf{fill:var(--ink);stroke:none}
.hand{font-family:var(--hand);fill:var(--ink);stroke:none}
.b{font-weight:700}
.hl{stroke:var(--ink);stroke-width:2}
.hl.d{stroke-width:4}
.body{filter:url(#wob)}
.hit{fill:transparent}
.obj{cursor:pointer;outline:none}
.obj:hover .body .ink,.obj:focus-visible .body .ink{stroke-width:5.6}
.obj:hover .body .thin,.obj:focus-visible .body .thin{stroke-width:4.2}
.obj:focus-visible .hit{stroke:var(--ink);stroke-width:3;stroke-dasharray:10 8}

/* 누를 수 있는 물건 곁의 반짝임 */
.rays line{stroke:var(--ink);stroke-width:3.5;stroke-linecap:round}
.rays{animation:glint 3.4s ease-in-out infinite;opacity:.1}
.kp-rays{animation:glint 1.3s ease-in-out infinite}
@keyframes glint{0%,100%{opacity:.08}45%,55%{opacity:.9}}
.cursor{animation:blink 1.1s steps(2,start) infinite}
@keyframes blink{to{visibility:hidden}}

/* 장면 넘기기 */
.scene{opacity:0;visibility:hidden;transition:opacity .4s ease,visibility 0s .4s}
.scene.on{opacity:1;visibility:visible;transition:opacity .4s ease}

/* 우편함 */
.lid,.flag,.mail-paper,.door-panel,.mat-body,[data-obj=mat] .hit{transform-box:fill-box}
.lid{transform-origin:0% 100%;transition:transform .4s cubic-bezier(.3,1.5,.5,1)}
[data-mail=open] .lid{transform:rotate(-28deg)}

/* 선물 상자 — 리본이 풀리고 뚜껑이 퐁, 종이 꽃가루, 카드가 올라온다 */
.gift-lid,.gift-bow,.gift-card,.conf{transform-box:fill-box}
.gift-lid{transform-origin:0% 100%;transition:transform .45s cubic-bezier(.3,1.6,.5,1)}
[data-gift=open] .gift-lid{transform:translate(-10px,-58px) rotate(-18deg)}
.gift-bow{transform-origin:50% 100%;transition:transform .35s ease-out,opacity .3s}
[data-gift=open] .gift-bow{transform:translateY(-70px) scale(.5);opacity:0}
.gift-card{opacity:0;transform:translateY(16px);transition:transform .5s .12s cubic-bezier(.3,1.4,.5,1),opacity .25s .12s}
[data-gift=open] .gift-card{opacity:1;transform:translateY(-70px)}
.conf{transform-origin:50% 50%;opacity:0}
[data-gift=open] .conf{animation:conf 1s cubic-bezier(.2,.7,.4,1) forwards}
@keyframes conf{0%{opacity:1;transform:translate(0,0) rotate(0)}80%{opacity:1}100%{opacity:0;transform:translate(var(--dx),var(--dy)) rotate(var(--r))}}

/* 도어락은 문에 붙어 있다 — 문이 열리면 문과 함께 사라진다 */
[data-obj=keypad]{transition:opacity .3s}
[data-door=open] [data-obj=keypad]{opacity:0;pointer-events:none}
.mail-inside{opacity:0;transition:opacity .2s}
[data-mail=open] .mail-inside{opacity:1}
.mail-paper{opacity:0;transform:translateY(30px);transition:transform .45s .15s,opacity .3s .15s}
[data-mail=open] .mail-paper{opacity:1;transform:translateY(-36px)}

/* 문 */
.door-panel{transform-origin:0% 50%;transition:transform .7s cubic-bezier(.4,0,.2,1)}
[data-door=open] .door-panel{transform:scaleX(.17)}
.rattle{animation:rattle .38s ease-in-out}
@keyframes rattle{0%,100%{transform:translateX(0)}20%{transform:translateX(-7px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(3px)}}

/* 키패드 불빛 */
.led{fill:var(--paper)}
[data-door=unlocked] .led,[data-door=open] .led{fill:var(--green)}
[data-kp=bad] .led{fill:var(--red)}
[data-door=unlocked] .kp-rays,[data-door=open] .kp-rays{animation:none;opacity:0}

/* 매트와 예비 열쇠 */
.mat-body{transform-origin:100% 100%;transition:transform .45s cubic-bezier(.3,1.3,.5,1)}
[data-mat=up] .mat-body{transform:translate(170px,-4px) rotate(5deg)}
[data-obj=mat] .hit{transition:transform .45s}
[data-mat=up] [data-obj=mat] .hit{transform:translateX(170px)}
[data-obj=key]{opacity:0;pointer-events:none;transition:opacity .3s}
[data-mat=up][data-key=here] [data-obj=key]{opacity:1;pointer-events:auto}

/* 화면 위 단추 */
.bar{position:absolute;top:10px;right:10px;display:flex;gap:8px;z-index:4}
.pill{font-family:var(--body);font-weight:500;font-size:14px;line-height:1.3;letter-spacing:.02em;background:var(--paper);color:var(--ink);
  border:2.5px solid var(--ink);border-radius:10px 14px 9px 13px;padding:6px 13px;cursor:pointer}
.pill:hover{background:var(--ink);color:var(--paper)}
.pill.strong{font-weight:600}
.nav{position:absolute;top:50%;margin-top:-46px;width:54px;height:92px;border:none;background:none;padding:0;cursor:pointer;z-index:4;color:var(--ink)}
.nav.l{left:4px}.nav.r{right:4px}
.nav svg{width:100%;height:100%;display:block}
.nav path{fill:none;stroke:currentColor;stroke-width:5;stroke-linecap:round;stroke-linejoin:round}
.nav:hover path{stroke-width:7}
.dots{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);display:flex;gap:10px;z-index:4}
.dots i{width:11px;height:11px;border-radius:50%;border:2.5px solid var(--ink)}
.dots i.on{background:var(--ink)}
.pill:focus-visible,.nav:focus-visible,.go:focus-visible,.keys button:focus-visible,.x:focus-visible{outline:3px solid var(--ink);outline-offset:3px}

/* 이름표 · 알림 */
.tip{position:absolute;z-index:5;pointer-events:none;font-family:var(--body);font-weight:500;font-size:14px;line-height:1.3;white-space:nowrap;
  background:var(--ink);color:var(--paper-hi);padding:5px 11px;border-radius:9px 12px 8px 11px;transform:translate(-50%,-140%);opacity:0;transition:opacity .12s}
.tip.on{opacity:1}
.toast{position:absolute;left:50%;bottom:44px;z-index:7;pointer-events:none;font-family:var(--body);font-weight:500;font-size:15px;white-space:nowrap;
  background:var(--ink);color:var(--paper-hi);padding:8px 16px;border-radius:12px;transform:translate(-50%,10px);opacity:0;transition:opacity .25s,transform .25s}
.toast.on{opacity:1;transform:translate(-50%,0)}

/* 뜨는 창 */
.veil{position:absolute;inset:0;z-index:6;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(45,41,38,.4)}
.card{position:relative;word-break:keep-all;overflow-wrap:break-word;box-sizing:border-box;width:min(470px,100%);max-height:100%;overflow:auto;padding:22px 24px 20px;
  background-color:var(--paper-hi);background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:20px 20px;
  border:2.5px solid var(--ink);border-radius:14px 10px 16px 9px;box-shadow:7px 9px 0 rgba(58,42,32,.28);font-size:15px;line-height:1.65;color:var(--ink)}
.card h3{font-family:var(--title);font-weight:700;font-size:25px;line-height:1.3;margin:0 44px 4px 0;text-wrap:balance}
.card h4.mini{font-family:var(--title);font-weight:700;font-size:18px;margin:18px 0 0}
.card:focus{outline:none}
.card p{margin:8px 0 0}
.card .sub{margin:0 0 6px;color:var(--ink-soft)}
.card dl{display:grid;grid-template-columns:auto 1fr;gap:3px 16px;margin:10px 0 0}
.card dt{font-weight:500;color:var(--ink-soft)}
.card dd{margin:0;min-width:0}
.card ul.list{margin:8px 0 0;padding-left:20px}
.todo{border:2px dashed var(--ink-soft);border-radius:8px;padding:5px 10px;color:var(--ink-soft);font-size:13.5px;margin-top:12px!important;background:var(--paper-hi)}
.links{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.links.col{flex-direction:column;align-items:flex-start}
.go{display:inline-block;font-family:var(--body);font-weight:500;font-size:14.5px;line-height:1.4;color:var(--ink);text-decoration:none;background:var(--paper-hi);
  border:2.5px solid var(--ink);border-radius:10px 13px 9px 12px;padding:6px 13px}
.go:hover{background:var(--ink);color:var(--paper-hi)}
.x{position:absolute;z-index:2;top:8px;right:10px;width:40px;height:40px;border:none;background:none;font-family:var(--body);font-size:28px;line-height:1;color:var(--ink);cursor:pointer}
.shake{animation:rattle .38s ease-in-out}
.book{display:grid;gap:0;margin-top:10px;padding:8px 12px;border-left:5px solid var(--ink);background:var(--paper-hi)}
.book b{font-weight:500;font-size:16px}
.book span{color:var(--ink-soft);font-size:14px}
.book em{font-style:normal;font-family:var(--title);font-size:15px;margin-top:2px}

/* 키패드 창 */
.hint{font-family:var(--body);font-weight:500;font-size:16px;margin:2px 0 14px!important}
.pad{display:grid;justify-items:center;gap:14px}
.disp{display:flex;align-items:center;justify-content:space-between;gap:14px;box-sizing:border-box;width:236px;max-width:100%;
  border:2.5px solid var(--ink);border-radius:8px;padding:6px 14px;background:var(--paper-hi)}
.digits{font-family:ui-monospace,"Consolas",monospace;font-size:30px;letter-spacing:.32em;font-variant-numeric:tabular-nums}
.lamp{width:17px;height:17px;border-radius:50%;border:2.5px solid var(--ink);background:var(--paper-hi);flex:none}
.lamp.ok{background:var(--green)}
.lamp.bad{background:var(--red)}
.keys{display:grid;grid-template-columns:repeat(3,62px);gap:10px}
.keys button{height:56px;font-family:var(--body);font-weight:500;font-size:22px;color:var(--ink);background:var(--paper-hi);border:2.5px solid var(--ink);border-radius:50%;cursor:pointer;padding:0}
.keys button:hover{background:var(--paper)}
.keys button:active{background:var(--ink);color:var(--paper-hi)}

/* 케이크 주문서 */
.receipt{position:relative;margin-top:4px;padding:14px 16px;background:var(--paper-hi);border:2px solid var(--ink);border-radius:4px}
.receipt h3{margin-right:0}
.receipt table{border-collapse:collapse;margin-top:6px;width:100%}
.receipt th{text-align:left;font-weight:400;color:var(--ink-soft);padding:3px 14px 3px 0;white-space:nowrap;vertical-align:top}
.receipt td{padding:3px 0;border-bottom:1.5px dashed var(--grid)}
.receipt td b{font-family:var(--title);font-weight:700;font-size:20px}
.stamp{position:absolute;right:14px;top:12px;font-family:var(--title);font-weight:700;font-size:16px;color:var(--red);border:3px solid var(--red);border-radius:50%;padding:8px 6px;transform:rotate(-14deg);opacity:.85}

/* 서랍 — 누르면 앞으로 빠진다 */
.drawer-front{transform-box:fill-box;transform-origin:50% 0%;transition:transform .4s cubic-bezier(.3,1.4,.5,1)}
[data-drawer=open] .drawer-front{transform:translateY(16px) scale(1.08)}

/* 일기장 — 줄 공책 */
.card.diary{background-image:linear-gradient(transparent 27px,var(--grid) 27px);background-size:100% 28px;border-left-width:10px}
.card.diary .empty{font-family:var(--title);font-size:18px;margin-top:14px}

/* 컴퓨터 — 누르면 모니터로 다가간 뒤 /devlog/ 로 넘어간다 */
.stage{overflow:hidden}
.stage>svg.zoom{transition:transform .6s cubic-bezier(.5,0,.75,.4),opacity .6s ease-in}
.stage>svg.zoom.in{opacity:.12}

/* 주소가 아직 없는 창 · 서랍 속 일기 목록 */
.soon{margin-top:12px!important;color:var(--ink-soft);font-family:var(--title)}
.diary-list{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:2px}
.diary-list a{display:grid;grid-template-columns:auto 1fr;gap:0 14px;align-items:baseline;padding:8px 6px;border-bottom:1.5px dashed var(--grid);color:var(--ink);text-decoration:none}
.diary-list a:hover{background:var(--paper)}
.diary-list span{color:var(--ink-soft);font-size:13px;font-variant-numeric:tabular-nums}
.diary-list b{font-family:var(--title);font-weight:700;font-size:17px;min-width:0}
button.go{cursor:pointer}
.go.small{font-size:13.5px;padding:4px 10px}
.lbl{font-family:var(--body);font-weight:500;fill:var(--ink);stroke:none}

/* 창밖 하늘 — 손님 컴퓨터 시각으로 낮 · 저녁 · 밤 */
.sky{fill:#dbe6ec}
[data-sky=eve] .sky{fill:#efd3bd}
[data-sky=night] .sky{fill:#3b4350}
.sun{fill:#f3e3a3;stroke:none}
[data-sky=eve] .sun{fill:#e7a06a}
.moon{fill:#f2edd6;stroke:none;display:none}
.stars circle{fill:#f2edd6;stroke:none}
.stars{display:none}
[data-sky=night] .sun{display:none}
[data-sky=night] .moon,[data-sky=night] .stars{display:inline}

/* 누르면 물건답게 — 흔들림 · 튀어나옴 · 들림 · 화면 켜짐 · 음표 */
.wig,.rise,.lift,.notes{transform-box:fill-box}
.wig{transform-origin:50% 0%}
.obj.poked .wig{animation:wig .5s ease-in-out}
@keyframes wig{0%,100%{transform:rotate(0)}25%{transform:rotate(-5deg)}50%{transform:rotate(4deg)}75%{transform:rotate(-2deg)}}
.rise{transform-origin:50% 100%}
.obj.poked .rise{animation:rise .6s cubic-bezier(.3,1.5,.5,1)}
@keyframes rise{0%,100%{transform:translateY(0)}45%{transform:translateY(-24px)}}
.lift{transform-origin:0% 100%}
.obj.poked .lift{animation:lift .7s ease-in-out}
@keyframes lift{0%,100%{transform:rotate(0)}40%,60%{transform:rotate(-24deg)}}
.notes{opacity:0}
.obj.poked .notes{animation:notes 1s ease-out}
@keyframes notes{0%{opacity:0;transform:translateY(0)}30%{opacity:1}100%{opacity:0;transform:translateY(-50px)}}
.glow{fill:var(--paper)}
.obj.poked .glow{animation:glow .9s ease-out}
@keyframes glow{0%,100%{fill:var(--paper)}30%,70%{fill:#f3dd9a}}

@media (prefers-reduced-motion:reduce){
  .obj.poked .wig,.obj.poked .rise,.obj.poked .lift,.obj.poked .notes,.obj.poked .glow{animation:none}
  .stage>svg.zoom,.drawer-front{transition:none}
  .rays,.kp-rays,.cursor{animation:none;opacity:.7}
  .scene,.lid,.mail-paper,.door-panel,.mat-body,.toast,.gift-lid,.gift-bow,.gift-card{transition:none}
  .conf{display:none}
  .rattle,.shake{animation:none}
}
</style>

<script is:inline>
(() => {
  /* ── 바꿔 끼울 값 ── */
  const BIRTHDAY = { m: 11, d: 7 };           // 람호 생일 — 비밀번호 1107
  const CODE = String(BIRTHDAY.m).padStart(2, '0') + String(BIRTHDAY.d).padStart(2, '0');
  const DATA = JSON.parse(document.getElementById('room-data').textContent);   // 위 --- 사이의 LINKS · 일기 목록
  const LINK = DATA.links;

  /* ── 브라우저 기억 (막혀 있어도 페이지는 돈다) ── */
  const mem = {
    get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
    set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} },
    del(k) { try { localStorage.removeItem(k); } catch (e) {} }
  };

  const WALLS = ['n', 'e', 's', 'w'];
  const S = { scene: 'porch', wall: 0, door: mem.get('u926-door') === 'open' ? 'open' : 'locked', mat: 'down', key: 'here', mail: 'shut', kp: '', drawer: 'shut', gift: 'shut' };
  let muted = mem.get('u926-mute') === '1';

  /* ── 소리 (누를 때만 난다 · 파일 없이 만든다) ── */
  let ac = null;
  function actx() {
    if (!ac) { try { ac = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { ac = null; } }
    if (ac && ac.state === 'suspended') ac.resume();
    return ac;
  }
  function tone(f, dur, type, vol, when) {
