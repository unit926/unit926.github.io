  /* ── 장면과 배치: [x, y, 크기, 기울기] · wide = 가로 화면, tall = 세로 화면 ── */
  const ROOM = {
    wide: `<path class="ink" d="M70 40 H1530 M70 40 V860 M1530 40 V860 M70 860 H1530 M70 40 L0 0 M1530 40 L1600 0 M70 860 L0 940 M1530 860 L1600 940"/>`,
    tall: `<path class="ink" d="M40 360 H860 M40 360 V1180 M860 360 V1180 M40 1180 H860 M40 360 L0 320 M860 360 L900 320 M40 1180 L0 1240 M860 1180 L900 1240"/>`
  };
  const WALL_AT = { wide: [70, 860, 1], tall: [40, 1180, 1] };   // 방 벽 왼쪽 바닥 자리 · 세로 화면은 방을 화면 가운데에 둔다
  const SCENES = [
    { id: 'porch', label: '현관 — 926호 앞 복도', base: {
        wide: `<path class="ink" d="M0 860 H1600 M0 40 H1600"/><path class="ink thin" d="M0 838 H1600"/>`,
        tall: `<path class="ink" d="M0 1180 H900 M0 360 H900"/><path class="ink thin" d="M0 1158 H900"/>` }, items: [
      /* 세로 화면은 폭이 좁아 우편함과 선물 상자를 문 쪽으로 당긴다 */
      { at: { wide: [628, 216, 1.15], tall: [278, 536, 1.15] }, draw: () => layout === 'tall'
          ? `<g transform="translate(94 0)">${gMailbox()}</g>${gDoor()}${gKeypad()}<g transform="translate(-76 0)">${gGift()}</g>`
          : gMailbox() + gDoor() + gKeypad() + gGift() } ] },
    { id: 'n', label: '첫 벽 — 책상과 수사 보드', base: ROOM, items: [ { at: WALL_AT, draw: wallN } ] },
    { id: 'e', label: '둘째 벽 — 창가 쉬는 자리', base: ROOM, items: [ { at: WALL_AT, draw: wallE } ] },
    { id: 's', label: '셋째 벽 — 현관 안쪽', base: ROOM, items: [ { at: WALL_AT, draw: wallS } ] },
    { id: 'w', label: '넷째 벽 — 액자와 수납장', base: ROOM, items: [ { at: WALL_AT, draw: wallW } ] }
  ];

  const DEFS = `<defs>
    <filter id="wob" x="-8%" y="-8%" width="116%" height="116%"><feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="7" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="4.5" xChannelSelector="R" yChannelSelector="G"/></filter>
    <pattern id="hatch" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(40)"><path d="M0 0 V12" class="hl"/></pattern>
    <pattern id="hatchD" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(40)"><path d="M0 0 V9" class="hl d"/></pattern>
  </defs>`;

  /* ── 뜨는 창 내용 — 주소가 빈 칸이면 「준비 중입니다.」가 뜬다 ── */
  const go = (href, text) => `<a class="go" href="${href}" target="_blank" rel="noopener">${text} ↗</a>`;
  const SOON = '<p class="soon">준비 중입니다.</p>';
  const or = (href, text) => href ? `<div class="links">${go(href, text)}</div>` : SOON;
  const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const PANEL = {
    presskit: `<h3>PRESS KIT</h3>
      <dl><dt>게임</dt><dd>흑색잔상 · Ashen Afterimage</dd><dt>개발</dt><dd>람호 / unit926 · 1인 개발</dd><dt>장르</dt><dd>3D 포인트앤클릭 퍼즐 어드벤처</dd><dt>엔진</dt><dd>Unity 6</dd></dl>
      <div class="links">${go(LINK.itch, 'itch.io')}${go(LINK.x, 'X')}<a class="go" href="/devlog/">데브로그</a></div>`,
    drawer: `<h3>일기장</h3><p class="sub">서랍 속 공책 — 개인적인 생각 · 일기</p>` + (DATA.diary.length
      ? `<ul class="diary-list">${DATA.diary.map(d => `<li><a href="${esc(d.href)}"><span>${esc(d.date)}</span><b>${esc(d.title)}</b></a></li>`).join('')}</ul>`
      : `<p class="empty">아직 쓴 일기가 없다.</p>`),
    steam: `<h3>Steam</h3><p class="sub">흑색잔상 게임 페이지</p>${or(LINK.steam, 'Steam 열기')}`,
    itch: `<h3>itch.io</h3><p class="sub">unit926</p>${or(LINK.itch, 'itch.io 열기')}`,
    card: `<h3>명함</h3><p class="sub">연락하기</p><dl><dt>개발</dt><dd>람호 / unit926</dd></dl>` +
      (LINK.email ? `<div class="links"><a class="go" href="mailto:${esc(LINK.email)}">${esc(LINK.email)}</a></div>` : SOON),
    console: `<h3>휴대용 게임기</h3><p class="sub">좋아하는 게임</p>${SOON}`,
    books: `<h3>책 더미</h3><p class="sub">좋아하는 만화 · 책</p><div class="book"><b>오늘부터 신령님</b><span>스즈키 줄리에타</span><em>마음이 힘들 때 즐겨 보는 만화</em></div>`,
    headphones: `<h3>작업할 때 듣는 노래</h3><ul class="list"><li>젤다의 전설 브레스 오브 더 와일드 사운드트랙</li><li>The Amazing Digital Circus 사운드트랙</li></ul>${or(LINK.playlist, '재생목록 듣기')}`,
    phone: `<h3>휴대폰</h3><p class="sub">SNS</p><div class="links col">${go(LINK.x, 'X @unit_926')}${go(LINK.youtube, 'YouTube @Unit926')}</div>`,
    wallpad: `<h3>월패드</h3><p class="sub">디스코드</p>${or(LINK.discord, '디스코드 들어가기')}`,
    memo: `<h3>메모판</h3><p class="sub">레딧</p>${or(LINK.reddit, 'Reddit u/unit926')}`,
    frames: `<h3>액자</h3><p class="sub">그림과 에셋 — 아트스테이션</p>${or(LINK.artstation, '아트스테이션 열기')}`,
    order: () => `<div class="receipt"><h3>케이크 주문서</h3><table>
      <tr><th>주문하신 분</th><td>람호</td></tr><tr><th>품목</th><td>생일 케이크 1개</td></tr>
      <tr><th>찾아가는 날</th><td><b>${BIRTHDAY.m}월 ${BIRTHDAY.d}일</b></td></tr></table><span class="stamp">접수</span></div>
      <p class="sub" style="margin-top:12px">우편함에 꽂혀 있던 종이다.</p>`
  };

  /* ── 화면 짓기 ── */
  const stage = document.getElementById('stage'), svg = document.getElementById('art');
  const tip = document.getElementById('tip'), toastEl = document.getElementById('toast');
  const navL = document.getElementById('navL'), navR = document.getElementById('navR'), dots = document.getElementById('dots');
  const muteBtn = document.getElementById('muteBtn');
  let layout = '', mode = '';

  function place(it, L) {
    const p = it.at[L];
    return `<g transform="translate(${p[0]} ${p[1]}) scale(${p[2] || 1})${p[3] ? ` rotate(${p[3]})` : ''}">${it.draw()}</g>`;
  }
  function build() {
    layout = innerHeight > innerWidth ? 'tall' : 'wide';
    mode = (layout === 'tall' || innerWidth < 900) ? 'full' : 'framed';
    document.body.classList.toggle('full', mode === 'full');
    document.body.classList.toggle('framed', mode === 'framed');
    svg.setAttribute('viewBox', layout === 'tall' ? '0 0 900 1600' : '0 0 1600 1000');
    const hr = new Date().getHours();
    svg.dataset.sky = hr >= 6 && hr < 17 ? 'day' : hr >= 17 && hr < 20 ? 'eve' : 'night';
    svg.innerHTML = DEFS + SCENES.map(sc =>
      `<g class="scene" id="sc-${sc.id}" role="group" aria-label="${sc.label}">${deco(sc.base[layout])}${sc.items.map(it => place(it, layout)).join('')}</g>`).join('');
    svg.querySelectorAll('.rays').forEach((r, i) => { r.style.animationDelay = ((i * 0.9) % 3.4).toFixed(2) + 's'; });
    sync();
  }
  function sync() {
    svg.dataset.door = S.door; svg.dataset.mat = S.mat; svg.dataset.key = S.key; svg.dataset.mail = S.mail; svg.dataset.kp = S.kp; svg.dataset.drawer = S.drawer; svg.dataset.gift = S.gift;
    const cur = S.scene === 'porch' ? 'porch' : WALLS[S.wall];
    svg.querySelectorAll('.scene').forEach(g => g.classList.toggle('on', g.id === 'sc-' + cur));
    const inRoom = S.scene === 'room';
    navL.hidden = navR.hidden = dots.hidden = !inRoom;
    [...dots.children].forEach((d, i) => d.classList.toggle('on', i === S.wall));
    muteBtn.textContent = muted ? '소리 끔' : '소리 켬';
    muteBtn.setAttribute('aria-pressed', String(muted));
  }

  /* ── 알림 · 이름표 ── */
  let toastT = 0;
  function toast(msg) {
    toastEl.textContent = msg; toastEl.classList.add('on');
    clearTimeout(toastT); toastT = setTimeout(() => toastEl.classList.remove('on'), 1900);
  }
  function tipAt(text, x, y) { tip.textContent = text; tip.style.left = x + 'px'; tip.style.top = y + 'px'; tip.classList.add('on'); }
  function hideTip() { tip.classList.remove('on'); }
  svg.addEventListener('pointermove', e => {
    if (e.pointerType !== 'mouse') return;
    const o = e.target.closest('[data-obj]');
    if (!o) { hideTip(); return; }
    const r = stage.getBoundingClientRect();
    tipAt(o.getAttribute('aria-label'), e.clientX - r.left, e.clientY - r.top);
  });
  svg.addEventListener('pointerleave', hideTip);
  svg.addEventListener('focusin', e => {
    const o = e.target.closest('[data-obj]'); if (!o) return;
    const a = o.getBoundingClientRect(), r = stage.getBoundingClientRect();
    tipAt(o.getAttribute('aria-label'), a.left + a.width / 2 - r.left, a.top - r.top + 10);
  });
  svg.addEventListener('focusout', hideTip);

  /* ── 뜨는 창 ── */
  let veil = null, lastFocus = null, kp = null;
  function openPanel(html, cls) {
    closePanel(true);
    lastFocus = document.activeElement;
    veil = document.createElement('div');
    veil.className = 'veil';
    veil.innerHTML = `<div class="card ${cls || ''}" role="dialog" aria-modal="true" tabindex="-1"><button type="button" class="x" aria-label="닫기">×</button>${html}</div>`;
    stage.appendChild(veil);
    veil.addEventListener('click', e => { if (e.target === veil || e.target.closest('.x')) closePanel(); });
    hideTip();
    try { veil.querySelector('.card').focus({ preventScroll: true }); } catch (e) {}
  }
  function closePanel(quiet) {
    if (!veil) return;
    veil.remove(); veil = null; kp = null;
    if (S.drawer === 'open') { S.drawer = 'shut'; SFX.drawer(); sync(); }
    if (S.gift === 'open') { S.gift = 'shut'; sync(); }
    if (!quiet && lastFocus && lastFocus.focus) { try { lastFocus.focus({ preventScroll: true }); } catch (e) {} }
  }

  /* ── 키패드 ── */
  function openKeypad() {
    const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', '⌫', '0', 'C'];
    openPanel(`<h3>키패드</h3><p class="hint">비번 : 내 생일</p>
      <div class="pad"><div class="disp"><span class="digits" id="digits">____</span><i class="lamp" id="lamp"></i></div>
      <div class="keys">${keys.map(k => `<button type="button" data-k="${k}" aria-label="${k === '⌫' ? '한 자 지우기' : k === 'C' ? '전부 지우기' : k}">${k}</button>`).join('')}</div></div>`, 'kpcard');
    kp = { v: '', busy: false };
    veil.querySelector('.keys').addEventListener('click', e => { const b = e.target.closest('[data-k]'); if (b) press(b.dataset.k); });
    showDigits();
    if (S.door !== 'locked') { lamp('ok'); kp.busy = true; veil.querySelector('.hint').textContent = '이미 열려 있다'; }
  }
  function showDigits() { const el = veil && veil.querySelector('#digits'); if (el) el.textContent = (kp.v + '____').slice(0, 4); }
  function lamp(state) { const el = veil && veil.querySelector('#lamp'); if (el) el.className = 'lamp' + (state ? ' ' + state : ''); }
  function press(k) {
    if (!kp || kp.busy) return;
    SFX.key();
    if (k === '⌫') kp.v = kp.v.slice(0, -1);
    else if (k === 'C') kp.v = '';
    else if (kp.v.length < 4) kp.v += k;
    showDigits();
    if (kp.v.length === 4) check();
  }
  function check() {
    kp.busy = true;
    if (kp.v === CODE) {
      lamp('ok');
      setTimeout(() => { closePanel(); unlock('철컥 — 문이 열렸다'); }, 650);
    } else {
      lamp('bad'); SFX.wrong();
      S.kp = 'bad'; sync();
      const card = veil.querySelector('.card'); card.classList.remove('shake'); void card.offsetWidth; card.classList.add('shake');
      setTimeout(() => {
        S.kp = ''; sync();
        if (!kp) return;
        kp.v = ''; kp.busy = false; lamp(''); showDigits();
      }, 750);
    }
  }

  /* ── 모니터 — 컴퓨터를 누르면 모니터로 다가간 뒤 /devlog/ (모니터 모양 쪽)으로 넘어간다 ── */
  function openMonitor() {
    closePanel(true); hideTip();
    const c = svg.querySelector('.scene.on [data-obj=computer]');
    if (c) {
      const a = c.getBoundingClientRect(), r = svg.getBoundingClientRect();
      svg.style.transformOrigin = (a.left + a.width * .5 - r.left) + 'px ' + (a.top + a.height * .5 - r.top) + 'px';
    }
    svg.classList.add('zoom'); void svg.getBoundingClientRect();
    svg.style.transform = 'scale(3.4)'; svg.classList.add('in');
    SFX.hum();
    setTimeout(() => { location.href = '/devlog/'; }, 520);
  }
  function resetZoom() { svg.style.transform = ''; svg.classList.remove('in', 'zoom'); }
  // 데브로그 쪽에서 브라우저 「뒤로」로 돌아오면 다가간 채로 멈춘 화면이 남지 않게 한다
  addEventListener('pageshow', e => { if (e.persisted) resetZoom(); });

  /* ── 움직임 ── */
  function unlock(msg) {
    S.door = 'unlocked'; mem.set('u926-door', 'open');
    SFX.right(); sync(); toast(msg);
  }
  function enter() {
    S.door = 'open'; SFX.door(); sync();
    setTimeout(() => { S.scene = 'room'; S.wall = 0; sync(); }, 700);
  }
  function turn(dir) {
    S.wall = (S.wall + dir + 4) % 4; SFX.step(); sync();
  }
  function rattle(o) {
    const b = o.querySelector('.body'); b.classList.remove('rattle'); void b.getBoundingClientRect(); b.classList.add('rattle');
  }
  function act(id, o) {
    switch (id) {
      case 'mailbox':
        if (S.mail === 'shut') { S.mail = 'open'; SFX.lid(); sync(); setTimeout(() => { SFX.paper(); openPanel(PANEL.order()); }, 620); }
        else { SFX.paper(); openPanel(PANEL.order()); }
        break;
      case 'presskit':
        if (S.gift === 'open') { openPanel(PANEL.presskit); break; }
        S.gift = 'open'; SFX.gift(); sync();
        setTimeout(() => openPanel(PANEL.presskit), 800);
        break;
      case 'keypad': openKeypad(); break;
      case 'door':
        if (S.door === 'locked') { rattle(o); SFX.rattle(); toast('잠겨 있다'); }
        else enter();
        break;
      case 'mat':
        S.mat = S.mat === 'down' ? 'up' : 'down'; SFX.step(); sync();
        if (S.mat === 'up' && S.key === 'here' && S.door === 'locked') toast('매트 밑에 무언가 있다');
        break;
      case 'key':
        S.key = 'taken'; sync();
        if (S.door === 'locked') unlock('예비 열쇠로 문을 열었다');
        break;
      case 'doorIn': S.scene = 'porch'; SFX.door(); sync(); break;
      case 'computer': openMonitor(); break;
      case 'drawer':
        if (S.drawer === 'open') break;
        S.drawer = 'open'; SFX.drawer(); sync();
        setTimeout(() => openPanel(PANEL.drawer, 'diary'), 420);
        break;
      default:
        if (!PANEL[id]) break;
        o.classList.remove('poked'); void o.getBoundingClientRect(); o.classList.add('poked');
        clearTimeout(o._pk); o._pk = setTimeout(() => o.classList.remove('poked'), 1100);
        (SFX[POKE_SFX[id]] || SFX.step)();
        setTimeout(() => openPanel(PANEL[id]), 420);
    }
  }
  svg.addEventListener('click', e => { const o = e.target.closest('[data-obj]'); if (o) act(o.dataset.obj, o); });
  svg.addEventListener('keydown', e => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const o = e.target.closest('[data-obj]'); if (!o) return;
    e.preventDefault(); act(o.dataset.obj, o);
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { if (veil) closePanel(); return; }
    if (kp) {
      if (/^[0-9]$/.test(e.key)) press(e.key);
      else if (e.key === 'Backspace') press('⌫');
      return;
    }
    if (!veil && !mon && S.scene === 'room') {
      if (e.key === 'ArrowLeft') turn(-1);
      if (e.key === 'ArrowRight') turn(1);
    }
  });
  navL.addEventListener('click', () => turn(-1));
  navR.addEventListener('click', () => turn(1));
  document.getElementById('pressBtn').addEventListener('click', () => openPanel(PANEL.presskit));
  muteBtn.addEventListener('click', () => { muted = !muted; mem.set('u926-mute', muted ? '1' : '0'); sync(); });

  let rt = 0;
  addEventListener('resize', () => {
    clearTimeout(rt);
    rt = setTimeout(() => {
      const L = innerHeight > innerWidth ? 'tall' : 'wide', M = (L === 'tall' || innerWidth < 900) ? 'full' : 'framed';
      if (L !== layout || M !== mode) build();
    }, 120);
  });

  build();

  /* 바로 가기 (#room-n · #keypad · #presskit 같은 주소 끝 표시) */
  const h = location.hash.slice(1);
  if (/^room-[nesw]$/.test(h)) { S.door = 'open'; S.scene = 'room'; S.wall = WALLS.indexOf(h[5]); sync(); }
  else if (h === 'keypad') openKeypad();
  else if (h === 'order') { S.mail = 'open'; sync(); openPanel(PANEL.order()); }
  else if (h === 'presskit') openPanel(PANEL.presskit);
  else if (h === 'matup') { S.mat = 'up'; sync(); }
  else if (h === 'devlog') location.replace('/devlog/');
  else if (h === 'lock') { mem.del('u926-door'); S.door = 'locked'; sync(); toast('문을 다시 잠갔다'); }   // 시험할 때 — 주소 끝에 #lock
  else if (h === 'diary') { S.door = 'open'; S.scene = 'room'; S.wall = 3; S.drawer = 'open'; sync(); openPanel(PANEL.drawer, 'diary'); }
  else if (/^panel-[a-z]+$/.test(h) && PANEL[h.slice(6)]) { S.door = 'open'; S.scene = 'room'; sync(); openPanel(PANEL[h.slice(6)]); }
})();
</script>
