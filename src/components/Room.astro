      const [pn, pw, ph] = MAIL_PAPER, w = pw / 2, h = ph / 2;
      paper = `<clipPath id="${cid}"><rect x="${x - 40}" y="${hy - 400}" width="260" height="400"/></clipPath>`
        + `<g clip-path="url(#${cid})"><g class="mail-paper">${PIC(pn, x + 79.8 - w / 2, hy - 8 - h, w, h)}</g></g>`;
    }
    return O('mailbox', '우편함', [x - 2, y - 10, 178, 208], PIC('mailbox', x, y, 181.5, 197.5) + paper
      + PIC('mail-lid', x + 26.3, y + 101.4, 106.5, 73.5, 'mail-lid') + PIC('mail-lid-open', x + 1.5, y + 118.6, 127.5, 56.5, 'mail-lid-open'));
  }

  function gDoor() {
    reseed('door'); VX = 142.5;
