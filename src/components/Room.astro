  }
  function outline(pts, w, a = .42, b = .28) {
    const n = pts.length; if (n < 2) return '';
    const cum = [0]; for (let i = 1; i < n; i++) cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
    const tot = cum[n - 1] || 1, ra = Math.min(16, tot * .3), rb = Math.min(26, tot * .42), ph = rr(0, 6.3), fr = rr(.004, .012);
    const Lp = [], Rp = [];
