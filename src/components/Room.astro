  const scrib = (x, y, w, R, o = {}) => { let d = ''; const n = Math.max(3, Math.round(w / 7)); for (let i = 0; i <= n; i++) { const px = x + w * i / n, py = y + (i % 2 ? -1.6 : 1.6) * rr(.5, 1.2); const p = R ? R(px, py) : [px, py]; d += (i ? 'L' : 'M') + n1(p[0]) + ' ' + n1(p[1]); } CV(d, o.w || 1.4, { soft: true, step: 3, j: .2 }); };

  /* 원근 — 벽마다 왼쪽 바닥이 0,0 · 위로 음수 · 1m = 300 · 눈높이 1.5m · 벽에서 5m 떨어져 본다. z는 벽에서 손님 쪽으로 나온 거리 */
  let VX = 0; const VY = -450, DD = 1500;
  const pj = (x, y, z = 0) => { const k = DD / (DD - z); return [VX + (x - VX) * k, VY + (y - VY) * k]; };
  function box3(x, y, w, h, z0, z1, o = {}) {
    const P = pj;
    const fTL = P(x, y, z1), fTR = P(x + w, y, z1), fBL = P(x, y + h, z1), fBR = P(x + w, y + h, z1);
    const bTL = P(x, y, z0), bTR = P(x + w, y, z0), bBL = P(x, y + h, z0), bBR = P(x + w, y + h, z0);
    const faces = [];
    if (y > VY && o.top !== false) faces.push([[bTL, bTR, fTR, fTL], o.ft || 'f0']);
    if (y + h < VY && o.bot !== false) faces.push([[bBL, bBR, fBR, fBL], o.fb || 'f3']);
    if (x > VX && o.side !== false) faces.push([[bTL, fTL, fBL, bBL], o.fs || 'f3']);
    if (x + w < VX && o.side !== false) faces.push([[fTR, bTR, bBR, fBR], o.fs || 'f3']);
    for (const [p, c] of faces) F(poly(p), c);
    const fr = [fTL, fTR, fBR, fBL];
    F(poly(fr), o.ff || 'f1');
    const pw = o.w ?? K2, seen = new Set();
    const edge = (a, b) => { const k = [a, b].map(p => p.map(Math.round).join(',')).sort().join('|'); if (seen.has(k)) return; seen.add(k); LP(a, b, pw); };
    for (const [p] of faces) for (let i = 0; i < 4; i++) edge(p[i], p[(i + 1) % 4]);
    for (let i = 0; i < 4; i++) edge(fr[i], fr[(i + 1) % 4]);
