  /* 문짝 — 손그림 두 장(닫힘 · 58도 열림 · 손잡이와 열린 쪽 도어락은 그림에 있다). 왼쪽 경첩(x = 0)에 붙어 있다.
     열리는 동안에는 닫힌 문이 경첩 쪽으로 좁아지며 사라지고, 열린 문이 넓은 데서 제자리로 좁혀지며 나타난다. e = 0(닫힘)~1(열림) */
  const DOOR_HY = -316;   // 문 높이 가운데 — 열린 문을 키우고 줄일 때 위아래로 고르게
  function doorPose(e) {
    const a = 1 - e, f = v => v.toFixed(3), m = (sx, sy) => `matrix(${f(sx)} 0 0 ${f(sy)} 0 ${n1(DOOR_HY * (1 - sy))})`;
    return [[m(1 + .67 * a, 1 - .16 * a), f(Math.min(1, e * 2.2))], [m(1 - .4 * e, 1), f(Math.max(0, 1 - e * 1.6))]];
  }
  function doorPic(e) {
    const shut = PIC('door', -2, -632.5, 289, 630.5), open = PIC('door-open', -0.5, -665.5, 173, 751.5);
    if (e <= 0) return shut;
    if (e >= 1) return open;
    const [o, c] = doorPose(e);
    return `<g class="dp-o" transform="${o[0]}" opacity="${o[1]}">${open}</g><g class="dp-c" transform="${c[0]}" opacity="${c[1]}">${shut}</g>`;
  }

  /* 도어락 — 손그림. 불빛 점(원본 59, 215px)에 코드 점을 얹어 번호가 맞으면 초록 · 틀리면 빨강으로 바꾼다 */
  function gKeypad() {
    return O('keypad', '도어락', [196, -420, 84, 142], PIC('keypad', 208.5, -407.5, 59.5, 117) + '<circle class="led" cx="238" cy="-300.3" r="6.5"/>');
  }

  /* 선물 상자 — 손그림 몸통 · 리본 달린 뚜껑 · 올라오는 카드. 카드는 상자 앞면 윗선(rim · 원본 57px) 아래로 숨겨 두었다가 올라온다.
     세로 화면은 판이 좁아 상자를 왼쪽으로 조금 당겼다 */
  function gGift() {
    const cx = W(533, 438), bx = cx - 111, by = -106, rim = by + 28.5, cid = 'gc' + (++UID);
    const card = `<clipPath id="${cid}"><rect x="${bx - 60}" y="${rim - 400}" width="380" height="400"/></clipPath>`
      + `<g clip-path="url(#${cid})"><g class="gift-card">${PIC('gift-card', cx - 66.8, rim - 67, 133.5, 93)}</g></g>`;
    const lid = `<g class="gift-lid">${PIC('gift-lid', cx - 109.3, rim - 74, 218.5, 80.5)}</g>`;
    const CONF = ['var(--s1)', 'var(--s2)', 'var(--s3)', 'var(--ink)', 'var(--a3)'];
    const top = [cx, rim - 20];
    const conf = Array.from({ length: 18 }, (_, i) => {
      const a = -Math.PI * (.06 + .88 * i / 17), d = 120 + (i * 37) % 90;
      const dx = Math.round(Math.cos(a) * d), dy = Math.round(Math.sin(a) * d - 30);
      return `<rect class="conf" x="${n1(top[0] - 4)}" y="${n1(top[1] - 7)}" width="8" height="14" rx="2" style="fill:${CONF[i % 5]};--dx:${dx}px;--dy:${dy}px;--r:${(i % 2 ? 1 : -1) * (160 + i * 25)}deg;animation-delay:${(i % 5) * .03}s"/>`;
    }).join('');
    return O('presskit', 'PRESS KIT', [bx - 8, rim - 90, 240, 152 - rim], PIC('gift', bx, by, 253.5, 162) + card + lid + conf);
  }

  /* 현관벽 손그림 — 넓은 화면 판(1600×1000)을 두 배로 그린 한 장. 판 밖은 가장자리를 거울처럼 뒤집어 잇는다.
     바닥은 아래로 길게 보일 수 있어 걸레받이 아래 바닥 띠만 뒤집어 이어 붙인다 (2026-10-25) */
  const PORCH_WALL = '/room/porch-wall.webp?v=2';
  // 현관 손그림 한 장 — public/room/porch-<이름>.webp. 람호 원본은 화면 좌표의 두 배 크기라 가로 · 세로를 절반으로 놓는다
  const PIC = (name, x, y, w, h, cls) => `<image${cls ? ` class="${cls}"` : ''} href="/room/porch-${name}.webp?v=1" x="${n1(x)}" y="${n1(y)}" width="${w}" height="${h}" preserveAspectRatio="none"/>`;
  new Image().src = '/room/porch-door-open.webp?v=1';   // 열린 문은 처음에 숨어 있어 문이 열리는 순간 비지 않게 미리 받아 둔다
  function porchWall() {
    const X0 = -657.5, Y0 = -790, PW = 1600, PH = 1000, fa = 6, fb = 210, fh = fb - fa;
    const img = (sx, ex, sy, ey, clip) => `<image href="${PORCH_WALL}" x="${X0}" y="${Y0}" width="${PW}" height="${PH}" preserveAspectRatio="none" transform="matrix(${sx} 0 0 ${sy} ${ex} ${ey})"${clip ? ' clip-path="url(#pw-floor)"' : ''}/>`;
    const cols = [[-1, 2 * X0], [1, 0], [-1, 2 * (X0 + PW)]];
    let o = `<clipPath id="pw-floor"><rect x="${X0 - 1}" y="${fa}" width="${PW + 2}" height="${fh}"/></clipPath>`;
    for (const [sx, ex] of cols) {
      o += img(sx, ex, -1, 2 * Y0) + img(sx, ex, 1, 0);
      for (let k = 1; k <= 4; k++) o += k % 2 ? img(sx, ex, -1, 2 * (fb + (k - 1) * fh), true) : img(sx, ex, 1, k * fh, true);
    }
    return `<g class="deco">${o}</g>`;
  }
  function porch() {
    const at = wide ? [657.5, 790, 1] : [293.25, 1150, 1.1];
    const back = PORCH_WALL ? (corridor(), porchWall()) : corridor();   // 코드 복도 그림은 남겨 둔다 — PORCH_WALL 을 '' 로 비우면 돌아온다
    return `<g transform="translate(${at[0]} ${at[1]}) scale(${at[2]})">${back}${gMailbox()}${gDoor()}${gKeypad()}${gGift()}</g>`;
  }

  /* ═════════ 방 — 926호 안 작업하는 방 ═════════
     첫 벽 = 책상과 수사 보드 · 둘째 벽 = 창가 쉬는 자리 · 셋째 벽 = 현관 안쪽 · 넷째 벽 = 액자와 수납장 */
  const WALL_AT = { wide: [90, 790, 1], tall: [40, 1150, 1.1] };
  const WALLW = { wide: 1420, tall: 745.5 }, WALLH = 734;
  const VXL = { wide: 710, tall: 372.7 };

  function roomShell(tag) {
    reseed('shell' + layout + tag);
    const [X0, Y0, SC] = WALL_AT[layout], WW = WALLW[layout] * SC, WH = WALLH * SC;
    const LX = -padX - 600, RX = (wide ? 1600 : 900) + padX + 600, TY = -padY - 600, VH = (wide ? 1000 : 1600) + padY + 600, vx = X0 + VXL[layout] * SC, vy = Y0 + VY * SC;
    const tl = [X0, Y0 - WH], tr = [X0 + WW, Y0 - WH], bl = [X0, Y0], br = [X0 + WW, Y0];
    const ext = (p, toX) => { const t = (toX - vx) / (p[0] - vx); return [toX, vy + (p[1] - vy) * t]; };
    const cTL = ext(tl, LX), cTR = ext(tr, RX), cBL = ext(bl, LX), cBR = ext(br, RX);
    return layer(() => {
      F(poly([[LX, Math.min(TY, cTL[1])], [RX, Math.min(TY, cTR[1])], cTR, tr, tl, cTL], 0), 'ceil');
      F(poly([cTL, tl, bl, cBL], 0), 'wall2'); F(poly([tr, cTR, cBR, br], 0), 'wall2');
      F(poly([bl, br, cBR, [RX, Math.max(VH, cBR[1])], [LX, Math.max(VH, cBL[1])], cBL], 0), 'floor');
      F(poly([tl, tr, br, bl], 0), 'wall');
      // 걸레받이
      const sk = 16 * SC; F(poly([[X0, Y0 - sk], [X0 + WW, Y0 - sk], br, bl], 0), 'f1'); L(X0, Y0 - sk, X0 + WW, Y0 - sk, K3);
      // 마루 — 소실점으로 모이는 널 줄과 엇갈린 이음매
      const gap = wide ? 104 : 82, xs = [];
      for (let x = X0 + gap * .5; x < X0 + WW; x += gap) xs.push(x);
      const at = (x, y) => [vx + (x - vx) * (y - vy) / (Y0 - vy), y];
      for (const x of xs) LP([x, Y0], at(x, VH), 1.5, { soft: true, ov: 0 });
      const rows = [Y0 + 30 * SC, Y0 + 75 * SC, Y0 + 140 * SC, Y0 + 230 * SC, Y0 + 360 * SC];
      for (let r = 0; r < rows.length; r++) for (let i = -1; i < xs.length; i++) {
        if (rnd() < .45) continue; const y = rows[r] + rr(-6, 6) * SC; if (y > VH) continue;
        const a = at(i < 0 ? X0 : xs[i], y), b = at(i + 1 >= xs.length ? X0 + WW : xs[i + 1], y); LP(a, b, 1.3, { soft: true, ov: 0 });
      }
      // 방 모서리
      LP(tl, tr, K1); LP(tr, br, K1); LP(br, bl, K1); LP(bl, tl, K1);
      LP(tl, cTL, K1); LP(tr, cTR, K1); LP(bl, cBL, K1); LP(br, cBR, K1);
      F(poly([cTL, tl, bl, cBL], 0), 'gL'); F(poly([tr, cTR, cBR, br], 0), 'gR');
      F(poly([tl, tr, [tr[0], tr[1] + 120 * SC], [tl[0], tl[1] + 120 * SC]], 0), 'gT');
      HT(poly([cTL, tl, [tl[0], tl[1] + 200 * SC], [cTL[0], cTL[1] + 220 * SC]], 0), 72, 20); HT(poly([tr, cTR, [cTR[0], cTR[1] + 220 * SC], [tr[0], tr[1] + 200 * SC]], 0), 108, 20);
    }, 'deco');
  }
  const placeWall = (inner) => { const [x, y, s] = WALL_AT[layout]; return `<g transform="translate(${x} ${y}) scale(${s})">${inner}</g>`; };

  /* 공용 꾸밈 조각 */
