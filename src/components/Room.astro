  }
  // 바닥 그림자 — 물건 발치에 빗금
  const floorShade = (x0, x1, z0, z1, ang = 18, gap = 7) => HT(poly([pj(x0, 0, z0), pj(x1, 0, z0), pj(x1, 0, z1), pj(x0, 0, z1)], 0), ang, gap);

  /* ── 누를 수 있는 물건 · 꾸밈 ── */
  function O(id, label, hit, inner, still) {
    return `<g class="obj${still ? ' still' : ''}" data-obj="${id}" tabindex="0" role="button" aria-label="${label}"><rect class="hit" x="${n1(hit[0])}" y="${n1(hit[1])}" width="${n1(hit[2])}" height="${n1(hit[3])}"/><g class="mv">${inner}</g></g>`;
  }
  let layout = 'wide', wide = true, padX = 0, padY = 0, aspect = 0;
  const W = (a, b) => wide ? a : b;

  /* ═════════ 현관 — 926호 앞 공동주택 복도 · 문 왼쪽 아래가 0,0 · 문 높이 630 = 2.1m ═════════ */
  function corridor() {
    reseed('corridor' + layout); VX = 142.5;
    const x0 = W(-1500, -700), x1 = W(1800, 1000), top = -760, bot = W(640, 900);
    return layer(() => {
      F(poly([[x0, top - 500], [x1, top - 500], [x1, top], [x0, top]], 0), 'ceil');
      F(poly([[x0, top], [x1, top], [x1, -330], [x0, -330]], 0), 'wall');
      F(poly([[x0, -330], [x1, -330], [x1, 0], [x0, 0]], 0), 'wall2');
      F(poly([[x0, -18], [x1, -18], [x1, 0], [x0, 0]], 0), 'f3');
