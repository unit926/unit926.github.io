      ${fr(fx + 145, -620, 193, 129, `<path class="ink thin" d="M${fx + 165} -512 Q${fx + 240} -590 ${fx + 318} -512"/>`)}
      ${fr(fx + 145, -478, 97, 92, `<circle class="ink thin" cx="${fx + 193}" cy="-432" r="18"/>`)}
      ${fr(fx + 258, -476, 113, 90, `<path class="ink thin" d="M${fx + 276} -414 h76 M${fx + 290} -428 h48"/>`)}
