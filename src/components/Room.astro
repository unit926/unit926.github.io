    if (quiet) v.remove(); else { v.querySelector('.sheet').classList.add('out'); v.style.transition = 'opacity .2s'; v.style.opacity = '0'; setTimeout(() => v.remove(), 200); }
    if (!quiet) unfocus();
    if (S.drawer === 'open') { S.drawer = 'shut'; SFX.drawer(); sync(); }
    if (S.gift === 'open') { S.gift = 'shut'; sync(); }
    // 초점을 물건에 돌려줄 때는 이름표를 띄우지 않는다 — 화면이 제자리로 돌아오기 전 위치에 떠 버린다
    if (!quiet && lastFocus && lastFocus.focus) { try { lastFocus.focus({ preventScroll: true }); } catch (e) {} }
    hideTip();
  }

  /* ── 도어락 ── */
  function openKeypad(o) {
    const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', '⌫', '0', 'C'];
    openPanel(`<h3>도어락</h3><p class="hint">비번 : 내 생일</p>
      <div class="pad"><div class="disp"><span class="digits" id="digits">____</span><i class="lamp" id="lamp"></i></div>
      <div class="keys">${keys.map(k => `<button type="button" data-k="${k}" aria-label="${k === '⌫' ? '한 자 지우기' : k === 'C' ? '전부 지우기' : k}">${k}</button>`).join('')}</div></div>`, 'kp', o);
    kp = { v: '', busy: false };
    veil.querySelector('.keys').addEventListener('click', e => { const b = e.target.closest('[data-k]'); if (b) press(b.dataset.k); });
    showDigits();
    if (S.door !== 'locked') { lamp('ok'); kp.busy = true; veil.querySelector('.hint').textContent = '이미 열려 있다'; }
  }
  function showDigits() { const el = veil && veil.querySelector('#digits'); if (el) el.textContent = (kp.v.replace(/./g, '•') + '____').slice(0, 4); }
  function lamp(state) { const el = veil && veil.querySelector('#lamp'); if (el) el.className = 'lamp' + (state ? ' ' + state : ''); }
  function press(k) {
    if (!kp || kp.busy) return;
    SFX.key();
    const b = veil.querySelector(`[data-k="${k}"]`); if (b) { b.classList.add('hit'); setTimeout(() => b.classList.remove('hit'), 140); }
    if (k === '⌫') kp.v = kp.v.slice(0, -1); else if (k === 'C') kp.v = ''; else if (kp.v.length < 4) kp.v += k;
    showDigits();
    if (kp.v.length === 4) check();
  }
  function check() {
    kp.busy = true;
    if (kp.v === CODE) { lamp('ok'); setTimeout(() => { closePanel(); unlock('철컥 — 문이 열렸다'); }, 650); }
    else {
      lamp('bad'); SFX.wrong(); S.kp = 'bad'; sync();
      const card = veil.querySelector('.sheet'); card.classList.remove('shake'); void card.offsetWidth; card.classList.add('shake');
      setTimeout(() => { S.kp = ''; sync(); if (!kp) return; kp.v = ''; kp.busy = false; lamp(''); showDigits(); }, 750);
    }
  }

  /* ── 모니터 — 컴퓨터를 누르면 모니터로 다가간 뒤 /devlog/ (모니터 모양 쪽)으로 넘어간다 ── */
  function openMonitor() {
    closePanel(true); hideTip();
    const c = svg.querySelector('.scene.on [data-obj=computer] .hit');
    if (c) { const a = c.getBoundingClientRect(), r = stage.getBoundingClientRect(); svg.style.transformOrigin = (a.left + a.width * .5 - r.left) + 'px ' + (a.top + a.height * .5 - r.top) + 'px'; }
    svg.classList.add('zoom'); void svg.getBoundingClientRect();
    svg.style.transform = 'scale(3.4)'; svg.classList.add('in');
    SFX.hum();
    setTimeout(() => { location.href = '/devlog/'; }, 520);
  }
  // 데브로그 쪽에서 브라우저 「뒤로」로 돌아오면 다가간 채로 멈춘 화면이 남지 않게 한다
  function resetZoom() { svg.style.transform = ''; svg.style.transformOrigin = ''; svg.classList.remove('in', 'zoom'); }

  /* ── 움직임 ── */
  function unlock(msg) { S.door = 'unlocked'; tab.set('u926-door', 'open'); SFX.right(); sync(); toast(msg); }
  function enter() {
    if (S.door === 'opening') return;
    SFX.door();
    const g = svg.querySelector('#sc-porch .door-open');
    const done = () => { S.door = 'open'; sync(); setTimeout(() => { S.scene = 'room'; S.wall = 0; sync(); }, 420); };
    if (S.door === 'open' || !g || matchMedia('(prefers-reduced-motion: reduce)').matches) { done(); return; }
    S.door = 'opening'; sync();
    // 화면 그리기 박자가 느린 곳(뒤에 숨은 탭 · 작은 창)에서도 문이 끝까지 열리도록 시간이 차면 끝 장면으로 마무리한다
    const t0 = performance.now(), dur = 640; let fin = false;
    const finish = () => { if (fin) return; fin = true; g.innerHTML = doorPic(1); done(); };
    g.innerHTML = doorPic(.001); const po = g.querySelector('.dp-o'), pc = g.querySelector('.dp-c');
    const step = now => {
      if (fin) return; const t = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - t, 3), [o, c] = doorPose(Math.max(.001, e));
      po.setAttribute('transform', o[0]); po.setAttribute('opacity', o[1]); pc.setAttribute('transform', c[0]); pc.setAttribute('opacity', c[1]);
      if (t < 1) requestAnimationFrame(step); else finish();
    };
    requestAnimationFrame(step); setTimeout(finish, dur + 120);
  }
  function turn(dir) { S.wall = (S.wall + dir + 4) % 4; SFX.step(); sync(); }
  function rattle(o) { const b = o.querySelector('.mv'); b.classList.remove('rattle'); void b.getBoundingClientRect(); b.classList.add('rattle'); }
  function poke(o) { o.classList.remove('poked'); void o.getBoundingClientRect(); o.classList.add('poked'); clearTimeout(o._pk); o._pk = setTimeout(() => o.classList.remove('poked'), 1100); }
  function act(id, o) {
    switch (id) {
      case 'mailbox':
        if (S.mail === 'shut') { S.mail = 'open'; SFX.lid(); sync(); setTimeout(() => { SFX.paper(); openPanel(PANEL.order(), 'receipt', o); }, 380); }
        else { SFX.paper(); openPanel(PANEL.order(), 'receipt', o); }
        break;
      case 'presskit':
        if (S.gift === 'open') { openPanel(PANEL.presskit, '', o); break; }
        S.gift = 'open'; SFX.gift(); sync();
        setTimeout(() => openPanel(PANEL.presskit, '', o), 560);
        break;
      case 'keypad': openKeypad(o); break;
      case 'door':
        if (S.door === 'locked') { rattle(o); SFX.rattle(); toast('잠겨 있다'); }
        else enter();
        break;
      case 'mat':
        S.mat = S.mat === 'down' ? 'up' : 'down'; SFX.mat(); sync();
        if (S.mat === 'up' && S.key === 'here' && S.door === 'locked') toast('매트 밑에 무언가 있다');
        break;
      case 'key': S.key = 'taken'; sync(); if (S.door === 'locked') unlock('예비 열쇠로 문을 열었다'); break;
      case 'doorIn': S.scene = 'porch'; SFX.door(); sync(); break;
      case 'computer': openMonitor(); break;
      case 'drawer':
        if (S.drawer === 'open') break;
        S.drawer = 'open'; SFX.drawer(); sync();
        setTimeout(() => openPanel(PANEL.drawer, 'diary', o), 340);
        break;
      default:
        if (!PANEL[id]) break;
        poke(o); (SFX[POKE_SFX[id]] || SFX.step)();
        setTimeout(() => openPanel(PANEL[id], PANEL_CLS[id], o), 220);
    }
  }
  svg.addEventListener('click', e => { const o = e.target.closest('[data-obj]'); if (o && !veil) act(o.dataset.obj, o); });
  svg.addEventListener('keydown', e => { if (e.key !== 'Enter' && e.key !== ' ') return; const o = e.target.closest('[data-obj]'); if (!o) return; e.preventDefault(); act(o.dataset.obj, o); });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { if (veil) closePanel(); return; }
    if (kp) { if (/^[0-9]$/.test(e.key)) press(e.key); else if (e.key === 'Backspace') press('⌫'); return; }
    if (!veil && S.scene === 'room') { if (e.key === 'ArrowLeft') turn(-1); if (e.key === 'ArrowRight') turn(1); }
  });
  navL.addEventListener('click', () => turn(-1));
  navR.addEventListener('click', () => turn(1));
  document.getElementById('pressBtn').addEventListener('click', () => openPanel(PANEL.presskit, ''));
  muteBtn.addEventListener('click', () => { muted = !muted; mem.set('u926-mute', muted ? '1' : '0'); sync(); });
  let rt = 0;
  addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => { const A = stage.clientWidth / Math.max(1, stage.clientHeight); if (Math.abs(A - aspect) > .01) { closePanel(true); unfocus(); build(); } }, 150); });
  addEventListener('pageshow', e => { if (e.persisted) resetZoom(); });

  build();

  /* 바로 가기 (#room-n · #keypad · #presskit 같은 주소 끝 표시) */
  const h = location.hash.slice(1);
  if (/^room-[nesw]$/.test(h)) { S.door = 'open'; S.scene = 'room'; S.wall = WALLS.indexOf(h[5]); sync(); }
  else if (h === 'keypad') openKeypad(svg.querySelector('[data-obj=keypad]'));
  else if (h === 'order') { S.mail = 'open'; sync(); openPanel(PANEL.order(), 'receipt', svg.querySelector('[data-obj=mailbox]')); }
  else if (h === 'presskit') { S.gift = 'open'; sync(); openPanel(PANEL.presskit, '', svg.querySelector('[data-obj=presskit]')); }
  else if (h === 'matup') { S.mat = 'up'; sync(); }
  else if (h === 'devlog') location.replace('/devlog/');
  else if (h === 'open') { S.door = 'open'; sync(); }
  else if (h === 'lock') { tab.del('u926-door'); S.door = 'locked'; sync(); toast('문을 다시 잠갔다'); }
  else if (h === 'diary') { S.door = 'open'; S.scene = 'room'; S.wall = 3; S.drawer = 'open'; sync(); openPanel(PANEL.drawer, 'diary', svg.querySelector('#sc-w [data-obj=drawer]')); }
  else if (/^panel-[a-z]+$/.test(h) && PANEL[h.slice(6)]) {
    const id = h.slice(6), wall = { steam: 0, itch: 0, card: 0, console: 1, books: 1, headphones: 1, phone: 2, wallpad: 2, memo: 2, frames: 3 }[id] ?? 0;
    S.door = 'open'; S.scene = 'room'; S.wall = wall; sync();
    openPanel(typeof PANEL[id] === 'function' ? PANEL[id]() : PANEL[id], PANEL_CLS[id], svg.querySelector(`#sc-${WALLS[wall]} [data-obj=${id}]`));
  }
})();
</script>
